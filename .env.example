# Optional local configuration. Never commit this file after adding credentials.
# Default: offline simulator, no API key and no Gmail connection.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
GMAIL_ENABLED=0
GMAIL_LABEL=campaigns
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
# Pub/Sub uses Google Application Default Credentials, separately from Gmail OAuth.
# Set a local credentials JSON path if your ADC setup requires it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/credentials.json
# Optional demo/behavior settings
CRA_SEED=1
CRA_DIGEST_HOUR=9
WORKER_POLL_SECONDS=30
